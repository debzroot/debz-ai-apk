pid /tmp/debz-nginx.pid;
error_log /opt/debz/logs/nginx-error.log;
events { worker_connections 64; }
http {
    include /etc/nginx/mime.types;
    access_log /opt/debz/logs/nginx-access.log;
    server {
        listen @WEB@;
        root /opt/debz/app;
        index index.html index.php;
        location / {
            try_files $uri $uri/ =404;
        }
        location ~ \.php$ {
            fastcgi_pass 127.0.0.1:@FPM@;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            include /etc/nginx/fastcgi_params;
            # Desktop (webui-nginx.conf) pakai 3600: chat SSE jalan menit-menit
            # (apalagi via proxy gratis yang lambat). Default nginx 60 dtk =
            # stream kepotong tengah jalan -> frontend "Maaf, Gak ada balesan".
            fastcgi_read_timeout 3600;
            fastcgi_send_timeout 3600;
            fastcgi_buffering off;
        }
    }
}
