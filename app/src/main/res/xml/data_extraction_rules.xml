<?xml version="1.0" encoding="utf-8"?>
<!-- Rootfs 130MB + session chat ga pernah boleh ikut backup cloud atau
     device-to-device transfer: restore ke ROM/arch lain bikin proot crash. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
